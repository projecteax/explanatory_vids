{
  "name": "widgeteers-moon-explainer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render MoonExplainer ../generated/video/moon_why_moon_changes_shape.mp4 --codec h264",
    "render:30": "remotion render MoonExplainer30 ../generated/video/moon_explainer_30s_silent.mp4 --codec h264",
    "render:final": "remotion render WidgeteersMoonFinal ../generated/video/widgeteers_moon_final_silent.mp4 --codec h264 --crf 17",
    "render:food": "remotion render WidgeteersFoodFinal ../generated/video/widgeteers_food_silent.mp4 --codec h264 --crf 17"
  },
  "dependencies": {
    "@remotion/cli": "4.0.286",
    "@remotion/media-utils": "4.0.286",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.286"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
